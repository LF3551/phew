{
  "name": "phew",
  "displayName": "Phew",
  "description": "Bug fixed. Phew. Open-source AI coding agent for VS Code: fix errors in one click, review every change, and use any model.",
  "version": "0.1.0",
  "publisher": "alekseialeinikov",
  "author": {
    "name": "Aleksei Aleinikov",
    "url": "https://www.alekseialeinikov.com"
  },
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#F0EDE8",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LF3551/phew"
  },
  "homepage": "https://github.com/LF3551/phew#readme",
  "bugs": {
    "url": "https://github.com/LF3551/phew/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "phew",
    "ai",
    "agent",
    "coding agent",
    "bug fix",
    "quick fix",
    "chat",
    "llm",
    "ollama",
    "openai",
    "mcp",
    "code review"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, Phew only answers questions. It does not change files, run commands, start MCP servers, or read project rules.",
      "restrictedConfigurations": [
        "phew.verify.command",
        "phew.commands.autoApprove",
        "phew.mcp.servers"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Phew needs files on disk to run commands and checks."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "phew",
          "title": "Phew",
          "icon": "resources/phew.svg"
        }
      ]
    },
    "views": {
      "phew": [
        {
          "id": "phew.chatView",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/phew.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "phew.openChat",
        "title": "Open Chat",
        "category": "Phew",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "phew.newChat",
        "title": "New Chat",
        "category": "Phew",
        "icon": "$(add)"
      },
      {
        "command": "phew.stop",
        "title": "Stop",
        "category": "Phew",
        "icon": "$(debug-stop)"
      },
      {
        "command": "phew.setMode",
        "title": "Switch Mode (Ask, Plan, Code)",
        "category": "Phew"
      },
      {
        "command": "phew.fixProblem",
        "title": "Phew it! Fix Problem at Cursor",
        "category": "Phew",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "phew.fixFileProblems",
        "title": "Phew it! Fix All Errors in File",
        "category": "Phew",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "phew.fixLastCommand",
        "title": "Phew it! Fix Last Failed Terminal Command",
        "category": "Phew",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "phew.makeChecksPass",
        "title": "Make Checks Pass",
        "category": "Phew",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "phew.askSelection",
        "title": "Ask About Selection",
        "category": "Phew"
      },
      {
        "command": "phew.switchModel",
        "title": "Switch Model",
        "category": "Phew"
      },
      {
        "command": "phew.addModel",
        "title": "Add Model",
        "category": "Phew"
      },
      {
        "command": "phew.manageModels",
        "title": "Manage Models",
        "category": "Phew"
      },
      {
        "command": "phew.testModel",
        "title": "Test Current Model",
        "category": "Phew"
      },
      {
        "command": "phew.showStats",
        "title": "Show Statistics",
        "category": "Phew"
      },
      {
        "command": "phew.openSettings",
        "title": "Open Settings",
        "category": "Phew",
        "icon": "$(gear)"
      },
      {
        "command": "phew.showLog",
        "title": "Show Log",
        "category": "Phew"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "phew.newChat",
          "when": "view == phew.chatView",
          "group": "navigation@1"
        },
        {
          "command": "phew.stop",
          "when": "view == phew.chatView && phew.busy",
          "group": "navigation@2"
        },
        {
          "command": "phew.openSettings",
          "when": "view == phew.chatView",
          "group": "navigation@3"
        },
        {
          "command": "phew.switchModel",
          "when": "view == phew.chatView",
          "group": "overflow@1"
        },
        {
          "command": "phew.manageModels",
          "when": "view == phew.chatView",
          "group": "overflow@1"
        },
        {
          "command": "phew.showStats",
          "when": "view == phew.chatView",
          "group": "overflow@2"
        },
        {
          "command": "phew.showLog",
          "when": "view == phew.chatView",
          "group": "overflow@3"
        }
      ],
      "editor/context": [
        {
          "command": "phew.askSelection",
          "when": "editorHasSelection",
          "group": "phew@1"
        },
        {
          "command": "phew.fixProblem",
          "when": "isWorkspaceTrusted",
          "group": "phew@2"
        }
      ],
      "commandPalette": [
        {
          "command": "phew.stop",
          "when": "phew.busy"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phew.openChat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "phew.fixProblem",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorTextFocus && isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Phew",
      "properties": {
        "phew.models": {
          "type": "array",
          "order": 1,
          "scope": "application",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "provider",
              "model"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "description": "Stable identifier. The API key in the secret storage uses it."
              },
              "name": {
                "type": "string",
                "description": "Display name in the model switcher."
              },
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "gemini",
                  "vscode"
                ],
                "enumDescriptions": [
                  "OpenAI Chat Completions format: OpenAI, Azure OpenAI, OpenRouter, Mistral, xAI, DeepSeek, Groq, Ollama, LM Studio, vLLM, LiteLLM, and more.",
                  "Native Anthropic Messages API.",
                  "Native Google Gemini API.",
                  "Language models that VS Code provides, for example GitHub Copilot."
                ]
              },
              "baseUrl": {
                "type": "string",
                "description": "API base URL, for example https://api.openai.com/v1."
              },
              "model": {
                "type": "string",
                "description": "Model name of the provider, or the VS Code language model ID."
              },
              "auth": {
                "type": "string",
                "enum": [
                  "bearer",
                  "api-key",
                  "x-api-key",
                  "x-goog-api-key",
                  "none"
                ],
                "description": "How the API key is sent. The default depends on the provider."
              },
              "apiKeyEnv": {
                "type": "string",
                "description": "Environment variable with the API key. A key in the secret storage wins."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra HTTP headers. Do not put secrets here."
              },
              "query": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra URL query parameters, for example api-version."
              },
              "extraBody": {
                "type": "object",
                "description": "Extra JSON fields for the request body, for example reasoning_effort, thinking, or generationConfig."
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1,
                "description": "Maximum output tokens. Anthropic uses 8192 when empty."
              },
              "price": {
                "type": "object",
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "description": "Price in US dollars per million tokens."
              }
            }
          },
          "markdownDescription": "Model profiles. Use **Phew: Add Model** and **Phew: Manage Models** instead of editing by hand. API keys are stored in the VS Code secret storage, not here. Only user settings can define models, so a workspace cannot redirect your API keys."
        },
        "phew.activeModel": {
          "type": "string",
          "order": 2,
          "default": "",
          "markdownDescription": "The `id` of the model in `#phew.models#` that Phew uses. Use **Phew: Switch Model** or the model button in the chat."
        },
        "phew.agent.defaultMode": {
          "type": "string",
          "enum": [
            "ask",
            "plan",
            "code"
          ],
          "enumDescriptions": [
            "Answers questions. Changes nothing.",
            "Explores the code and writes a plan. Changes nothing.",
            "Edits files and runs commands with your approval."
          ],
          "default": "code",
          "markdownDescription": "Mode for new workspaces."
        },
        "phew.agent.maxSteps": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "Maximum number of model calls in one task."
        },
        "phew.edits.requireApproval": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show every file change as hunks and apply only the hunks that you select. When off, Phew applies changes at once. Checkpoints still let you undo them."
        },
        "phew.commands.autoApprove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command prefixes that run without a confirmation, for example `npm test` or `go test`. Dangerous and chained commands always ask."
        },
        "phew.commands.deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command prefixes that never run."
        },
        "phew.commands.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 3600,
          "markdownDescription": "Time limit of one command."
        },
        "phew.verify.command": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Command that checks the work, for example `npm test` or `npm run lint && npm test`. In Code mode, Phew runs it after changes and keeps fixing until it passes."
        },
        "phew.verify.maxAttempts": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "markdownDescription": "How many times Phew runs the check before it stops."
        },
        "phew.budget.maxCostPerTask": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Stop a task when its cost reaches this amount in US dollars. `0` means no limit. Needs a `price` in the model profile."
        },
        "phew.budget.maxTokensPerTask": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Stop a task when it uses this number of tokens. `0` means no limit."
        },
        "phew.privacy.redactSecrets": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Remove values that look like keys, tokens, and passwords from tool output before it goes to the model."
        },
        "phew.privacy.sensitiveNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra file name parts that Phew never reads, in addition to `.env`, keys, and credential files."
        },
        "phew.mcp.servers": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ]
          },
          "markdownDescription": "MCP servers that Phew starts over stdio in Code mode. Example: `{ \"github\": { \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-github\"] } }`."
        },
        "phew.mcp.requireApproval": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before each MCP tool call."
        },
        "phew.terminal.offerFix": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer **Phew it!** when a command fails in the integrated terminal. Needs terminal shell integration."
        },
        "phew.ui.celebrate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a short **Phew! Done.** animation when a task changes files successfully."
        },
        "phew.stats.minutesPerBug": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 600,
          "markdownDescription": "Minutes that one fixed bug saves, for the estimated time saved in the statistics."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/webview/tsconfig.json --noEmit",
    "lint": "biome check src test scripts media",
    "format": "biome check --write src test scripts media",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "npm run check && node scripts/build.mjs --production && vsce package --out phew.vsix",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "test:integration": "node scripts/build.mjs && node test/integration/run.mjs",
    "check:providers": "node scripts/check-providers.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
